# ─────────────────────────────────────────────────────────────
# 이 파일을 .env.local로 복사하면 바로 실행됩니다.
#
#   cp .env.example .env.local
#   npm run dev
#
# 아래 두 줄만으로 MSW mock이 켜지고, 백엔드·AI 서버 없이
# 모든 화면이 동작합니다. 나머지 항목은 전부 선택입니다.
# ─────────────────────────────────────────────────────────────

# MSW mock 활성화. 'enabled'일 때만 켜진다.
NEXT_PUBLIC_API_MOCKING=enabled

# 비워두면 client.ts가 window.location.origin을 쓴다.
# mock 핸들러가 '*/api/...' 와일드카드로 매칭하므로 그대로 가로채진다.
NEXT_PUBLIC_API_URL=


# ─────────────────────────────────────────────────────────────
# 여기서부터는 실제 서버에 붙일 때만 채웁니다.
# mock을 쓰는 동안에는 비워 두세요 — 값을 넣으면 그 주소로
# 실제 요청이 나가고, 핸들러가 없는 경로는 404가 납니다.
# ─────────────────────────────────────────────────────────────

# 서버 주소. 비우면 NEXT_PUBLIC_API_URL이나 현재 origin으로 대체된다.
NEXT_PUBLIC_AUTH_API_URL=
NEXT_PUBLIC_USER_API_URL=
NEXT_PUBLIC_AI_PUBLIC_API_URL=
NEXT_PUBLIC_PAYMENT_BASE_URL=

# 내부 호출 시크릿. AI 서버와 BE의 /internal/** 경로가 요구한다.
# mock은 값을 검사하지 않으므로 로컬에서는 비워 둬도 된다.
NEXT_PUBLIC_INTERNAL_SECRET=

# Cloudflare Turnstile site key. 봇으로 의심될 때 뜨는 재검증 위젯에 쓴다.
# mock은 재검증 이벤트를 보내지 않으므로 로컬에서는 그 화면이 나오지 않는다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 카카오 로그인. 서버(Route Handler)에서만 읽는 값이라 NEXT_PUBLIC_ 접두어가 없다.
KAKAO_REST_API_KEY=
KAKAO_SCOPE=
NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=
NEXT_PUBLIC_KAKAO_SCOPE=

# 이미지 업로드 경로. 비우면 기본값을 쓴다.
NEXT_PUBLIC_UPLOAD_API_PATH=


# ─────────────────────────────────────────────────────────────
# 시연용 이벤트 지정 (선택)
#
# 특정 공연에서만 다른 흐름을 태우고 싶을 때 씁니다.
# 비워 두면 해당 분기가 동작하지 않습니다.
# ─────────────────────────────────────────────────────────────

# 아래 두 값의 공통 기본값
NEXT_PUBLIC_MOCK_EVENT_ID=

# 이 공연에 들어가면 로그인을 요구한다. 비우면 요구하지 않는다.
NEXT_PUBLIC_MOCK_LOGIN_EVENT_ID=

# 이 공연을 '예매 완료' 상태로 취급한다. 비우면 6025번이 기본값이다.
NEXT_PUBLIC_MOCK_BOOKING_COMPLETE_EVENT_ID=
