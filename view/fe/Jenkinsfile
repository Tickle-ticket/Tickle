pipeline {
    agent any

    tools {
        nodejs 'node20' 
    }

    environment {
        PROJECT_PATH = 'view/fe/tickle'
        EC2_USER = 'ubuntu'
        EC2_IP = '13.124.218.77'
        TARGET_DIR = '/home/ubuntu/S14P31A203/view/fe/tickle'
        SSH_CREDENTIAL_ID = 'fe-ec2-key'
        MATTERMOST_WEBHOOK = 'https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '===== [1/4] 코드 체크아웃 시작 ====='
                checkout scm
                echo "브랜치: ${env.GIT_BRANCH}"
                echo "커밋: ${env.GIT_COMMIT}"
            }
        }

        stage('FE Build') {
            steps {
                dir("${env.PROJECT_PATH}") {
                    echo '===== [2/4] pnpm 환경 구축 및 Next.js 빌드 ====='
                    sh 'npm install -g pnpm'
                    sh '''
                        rm -rf node_modules
                        pnpm install --no-frozen-lockfile --shamefully-hoist
                        pnpm approve-builds
                        NEXT_PUBLIC_API_MOCKING=disabled pnpm build
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                // [핵심 변경] dir 블록 바깥에서 sshagent를 실행하여 젠킨스 내부 폴더 꼬임을 원천 차단 (BE 방식)
                sshagent([SSH_CREDENTIAL_ID]) {
                    echo '===== [3/4] 파일 압축 및 서버 전송 ====='
                    
                    // 1. 빌드 파일 압축 (명시적 경로 사용)
                    sh "cd ${env.PROJECT_PATH} && tar -czf deploy.tar.gz .next public package.json pnpm-lock.yaml next.config.ts"

                    // 2. 서버 폴더 준비 및 소유권 설정
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} '
                            set -e
                            mkdir -p ${TARGET_DIR}
                            sudo chown -R ${EC2_USER}:${EC2_USER} /home/ubuntu/S14P31A203
                        '
                    """

                    // 3. 파일 전송 (SCP)
                    sh "scp -o StrictHostKeyChecking=no ${env.PROJECT_PATH}/deploy.tar.gz ${EC2_USER}@${EC2_IP}:${TARGET_DIR}"

                    // 4. 배포 실행
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} '
                            set -e
                            cd ${TARGET_DIR}
                            tar -xzf deploy.tar.gz
                            rm deploy.tar.gz
                            docker compose up -d --build
                        '
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                echo '===== [4/4] 배포 완료 확인 ====='
                sshagent([SSH_CREDENTIAL_ID]) {
                    sh "ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} 'cd ${TARGET_DIR} && docker compose ps'"
                }
            }
        }
    }

    post {
        success {
            script {
                def shortCommit = env.GIT_COMMIT?.take(7) ?: '???????'
                def branch = env.GIT_BRANCH ?: '?'
                def jobUrl = env.BUILD_URL ?: '#'
                def author = env.GIT_AUTHOR_NAME ?: '누군가'
                def msg = """{"text": "", "attachments": [{"color": "#00c851", "title": "🚀 FE(Withy) 배포 성공!", "fields": [{"short": true, "title": "👤 작업자", "value": "${author}"}, {"short": true, "title": "🌲 브랜치", "value": "${branch}"}, {"short": true, "title": "🔗 접속", "value": "http://${env.EC2_IP}:3000"}, {"short": true, "title": "⏱️ 소요", "value": "${currentBuild.durationString.replace(' and counting', '')}"}], "footer": "Tickle Jenkins"}]}"""
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '${msg}' ${env.MATTERMOST_WEBHOOK}"
            }
        }
        failure {
            script {
                def shortCommit = env.GIT_COMMIT?.take(7) ?: '???????'
                def branch = env.GIT_BRANCH ?: '?'
                def jobUrl = env.BUILD_URL ?: '#'
                def author = env.GIT_AUTHOR_NAME ?: '누군가'
                def failMsg = ["아 ${author}야 프론트 배포 터졌어 빨리 봐 🚨", "${author} FE CD 나갔는데 ㅋㅋ 확인해", "${author} 프론트 서버 죽었다 살려줘 😭", "${author}!! FE 배포 빨간불 ㅠ 고쳐줘"][new Random().nextInt(4)]
                def msg = """{"text": "> ${failMsg}", "attachments": [{"color": "#ff4444", "title": "💥 FE(Withy) 배포 실패!", "fields": [{"short": true, "title": "👤 담당자", "value": "**${author}**"}, {"short": true, "title": "🌲 브랜치", "value": "${branch}"}, {"short": true, "title": "🔗 빌드", "value": "[Jenkins 확인하러 가기](${jobUrl})"}], "footer": "Tickle Jenkins"}]}"""
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '${msg}' ${env.MATTERMOST_WEBHOOK}"
            }
        }
    }
}