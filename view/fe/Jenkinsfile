pipeline {
    agent any

    tools {
        // 젠킨스 도구 설정에 등록된 Node.js 20 버전 사용
        nodejs 'node20' 
    }

    environment {
        // 프로젝트 내부 경로 및 서버 정보 설정
        PROJECT_PATH = "view/fe/tickle"
        EC2_USER = "ubuntu"
        EC2_IP = "3.38.111.218"
        TARGET_DIR = "/home/ubuntu/S14P31A203/view/fe/tickle"
        
        // 젠킨스 Credentials ID
        SSH_CREDENTIAL_ID = "fe-ec2-key"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "===== [1/4] 소스 코드 체크아웃 ====="
                checkout scm
            }
        }

        stage('FE Build') {
            steps {
                dir("${env.PROJECT_PATH}") {
                    echo "===== [2/4] pnpm 환경 구축 및 Next.js 빌드 ====="
                    
                    // 최신 pnpm 설치 및 pnpm v10 대응
                    sh "npm install -g pnpm"
                    
                    // --shamefully-hoist: react-datepicker 등의 타입 인식 문제를 해결하기 위해 패키지를 평탄화합니다.
                    // pnpm approve-builds: pnpm v10에서 보안으로 차단된 빌드 스크립트를 명시적으로 승인합니다.
                    sh """
                        rm -rf node_modules
                        pnpm install --no-frozen-lockfile --shamefully-hoist
                        pnpm approve-builds
                    """
                    
                    // Next.js 빌드 실행
                    sh "NEXT_PUBLIC_API_MOCKING=disabled pnpm build"
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${env.PROJECT_PATH}") {
                    echo "===== [3/4] 경로 권한 설정 및 파일 전송 ====="
                    
                    // 배포 파일 압축 (next.config.ts 포함 여부 확인 필수)
                    sh "tar -czf deploy.tar.gz .next public package.json pnpm-lock.yaml next.config.ts"

                    sshagent([SSH_CREDENTIAL_ID]) {
                        // [핵심] SSH 에이전트가 사용하는 임시 키 경로(@tmp)에 대한 권한 부여
                        // SSH는 키 파일이나 폴더 권한이 너무 개방적이면 실행을 거부하므로 소유자 전용으로 제한합니다.
                        sh """
                            chmod 700 ${env.WORKSPACE}@tmp
                            chmod 600 ${env.WORKSPACE}@tmp/*
                        """

                        // 1. EC2 서버 측 목적지 폴더 생성 및 소유권 강제 변경
                        sh """
                            ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} \
                            "mkdir -p ${TARGET_DIR} && sudo chown -R ${EC2_USER}:${EC2_USER} /home/ubuntu/S14P31A203"
                        """

                        // 2. 압축 파일 전송
                        sh "scp -o StrictHostKeyChecking=no deploy.tar.gz ${EC2_USER}@${EC2_IP}:${TARGET_DIR}"

                        // 3. 서버 내부에서 압축 해제 및 도커 컴포즈 재시작
                        sh """
                            ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} "
                                cd ${TARGET_DIR} &&
                                tar -xzf deploy.tar.gz &&
                                rm deploy.tar.gz &&
                                docker compose up -d --build
                            "
                        """
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                echo "===== [4/4] 배포 완료 확인 ====="
                sshagent([SSH_CREDENTIAL_ID]) {
                    sh "ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} 'docker compose ps'"
                }
            }
        }
    }

    post {
        success {
            script {
                def message = "✅ **Tickle 프론트 배포 성공!**\n- 빌드 번호: #${env.BUILD_NUMBER}\n- 주소: http://${env.EC2_IP}:3000"
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '{\"text\": \"${message}\"}' https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr"
            }
        }
        failure {
            script {
                def message = "🚨 **Tickle 프론트 배포 실패!**\n- 로그 확인: ${env.BUILD_URL}"
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '{\"text\": \"${message}\"}' https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr"
            }
        }
    }
}