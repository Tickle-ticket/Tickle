pipeline {
    agent any

    // 젠킨스 Tools에 등록한 node20 설정을 불러옵니다.
    tools {
        nodejs 'node20' 
    }

    environment {
        // Mattermost 알림 채널 웹훅 URL
        MATTERMOST_WEBHOOK = 'https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr'
        // 프론트엔드 EC2 서버 정보
        FE_SERVER = 'ubuntu@k14a203.p.ssafy.io'
        // 서버 내 메인 앱 배포 경로
        PROJECT_PATH = '~/S14P31A203/view/fe/tickle'
        // 서버 내 스토리북 배포 경로
        STORYBOOK_PATH = '~/S14P31A203/view/fe/storybook'
        // 젠킨스에 등록한 SSH Credentials ID
        SSH_CREDENTIAL_ID = 'fe-ec2-key'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '===== [1/5] tickle 프론트엔드 코드 체크아웃 ====='
                checkout scm
            }
        }

        stage('FE Build') {
            steps {
                echo '===== [2/5] 메인 앱(MSW 포함) 및 스토리북 빌드 시작 ====='
                dir('view/fe/tickle') {
                    sh 'npm install -g pnpm'
                    sh 'pnpm install'
                    
                    // ⭐️ MSW 활성화 환경변수를 주입하여 빌드
                    sh 'NEXT_PUBLIC_API_MOCKING=enabled pnpm build'
                    
                    // 스토리북 정적 파일 빌드
                    sh 'pnpm build-storybook'
                    
                    // E2E 테스트를 위한 브라우저 설치
                    sh 'pnpm exec playwright install --with-deps'
                }
            }
        }

        stage('E2E Test') {
            steps {
                echo '===== [3/5] Playwright E2E 테스트 실행 ====='
                dir('view/fe/tickle') {
                    // 테스트가 실패하면 배포(Deploy) 단계로 넘어가지 않습니다.
                    sh 'pnpm exec playwright test'
                }
            }
            post {
                always {
                    // 테스트 리포트 보관 (실패 원인 분석용)
                    archiveArtifacts artifacts: 'view/fe/tickle/playwright-report/**', allowEmptyArchive: true
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '===== [4/5] EC2 원격 배포 시작 (App & Storybook) ====='
                sshagent([env.SSH_CREDENTIAL_ID]) {
                    // 1. 메인 앱 압축 및 전송
                    sh "tar -czf build.tar.gz -C view/fe/tickle .next public package.json pnpm-lock.yaml"
                    sh "scp -o StrictHostKeyChecking=no build.tar.gz ${env.FE_SERVER}:${env.PROJECT_PATH}"
                    
                    // 2. 스토리북 결과물 압축 및 전송
                    sh "tar -czf storybook.tar.gz -C view/fe/tickle/storybook-static ."
                    sh "scp -o StrictHostKeyChecking=no storybook.tar.gz ${env.FE_SERVER}:${env.STORYBOOK_PATH}"
                    
                    // 3. 서버에서 각각 압축 해제 및 서비스 재시작
                    sh """
                        ssh -o StrictHostKeyChecking=no ${env.FE_SERVER} "
                            # 메인 앱 반영
                            cd ${env.PROJECT_PATH} &&
                            tar -xzf build.tar.gz &&
                            rm build.tar.gz &&
                            pnpm install --prod &&
                            pm2 restart frontend

                            # 스토리북 반영
                            cd ${env.STORYBOOK_PATH} &&
                            tar -xzf storybook.tar.gz &&
                            rm storybook.tar.gz
                        "
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                echo '===== [5/5] 배포 상태 확인 ====='
                sh "curl -I https://k14a203.p.ssafy.io"
            }
        }
    }

    post {
        success {
            script {
                def msg = """{"text": "✅ **tickle 프론트엔드 배포 완료! (MSW 활성)**\\n메인: https://k14a203.p.ssafy.io\\n스토리북: https://k14a203.p.ssafy.io/storybook"}"""
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '${msg}' ${env.MATTERMOST_WEBHOOK}"
            }
        }
        failure {
            script {
                def msg = """{"text": "🚨 **tickle 프론트 배포 실패!** 빌드 에러나 테스트 실패 여부를 확인해줘!"}"""
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '${msg}' ${env.MATTERMOST_WEBHOOK}"
            }
        }
    }
}