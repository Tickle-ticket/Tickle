pipeline {
    agent any

    // 젠킨스 Tools에 등록한 node20 설정을 불러옵니다.
    tools {
        nodejs 'node20' 
    }

    environment {
        // Mattermost 알림 채널 웹훅 URL
        MATTERMOST_WEBHOOK = 'https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr'
        // 프론트엔드 EC2 서버 정보
        FE_SERVER = 'ubuntu@k14a203.p.ssafy.io'
        // 서버 내 메인 앱 배포 경로
        PROJECT_PATH = '~/S14P31A203/view/fe/tickle'
        // 서버 내 스토리북 배포 경로
        STORYBOOK_PATH = '~/S14P31A203/view/fe/storybook'
        // 젠킨스에 등록한 SSH Credentials ID
        SSH_CREDENTIAL_ID = 'fe-ec2-key'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '===== [1/5] tickle 프론트엔드 코드 체크아웃 ====='
                checkout scm
            }
        }

        stage('FE Build') {
            steps {
                echo '===== [2/5] 메인 앱 및 스토리북 빌드 시작 ====='
                dir('view/fe/tickle') {
                    sh 'npm install -g pnpm'
                    sh 'pnpm install'
                    
                    // .env 파일을 빌드 시점에 참조하여 Next.js 빌드 수행
                    sh 'NEXT_PUBLIC_API_MOCKING=disabled pnpm build'
                    
                    // 스토리북 정적 파일 빌드
                    sh 'pnpm build-storybook'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '===== [3/5] EC2 원격 배포 시작 (App & Storybook) ====='
                sshagent([env.SSH_CREDENTIAL_ID]) {
                    
                    // 1. 메인 앱 압축 (.env 파일 반드시 포함!)
                    // view/fe/tickle 폴더 내의 핵심 파일들과 .env를 묶습니다.
                    sh "tar -czf build.tar.gz -C view/fe/tickle .next public package.json pnpm-lock.yaml .env"
                    sh "scp -o StrictHostKeyChecking=no build.tar.gz ${env.FE_SERVER}:${env.PROJECT_PATH}"
                    
                    // 2. 스토리북 결과물 압축
                    sh "tar -czf storybook.tar.gz -C view/fe/tickle/storybook-static ."
                    sh "scp -o StrictHostKeyChecking=no storybook.tar.gz ${env.FE_SERVER}:${env.STORYBOOK_PATH}"
                    
                    // 3. 서버에서 각각 압축 해제 및 서비스 재시작
                    sh """
                        ssh -o StrictHostKeyChecking=no ${env.FE_SERVER} "
                            # --- 메인 앱 반영 ---
                            cd ${env.PROJECT_PATH} &&
                            
                            # 기존 빌드 잔재 삭제 (캐시 및 덮어쓰기 오류 방지)
                            rm -rf .next public .env &&
                            
                            tar -xzf build.tar.gz &&
                            rm build.tar.gz &&
                            
                            # 의존성 설치 및 PM2 재시작 (--update-env로 .env 변화 반영)
                            pnpm install --prod &&
                            pm2 restart frontend --update-env || pm2 start pnpm --name 'frontend' -- start

                            # --- 스토리북 반영 ---
                            cd ${env.STORYBOOK_PATH} &&
                            rm -rf * &&
                            tar -xzf storybook.tar.gz &&
                            rm storybook.tar.gz
                        "
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                echo '===== [4/5] 배포 상태 확인 ====='
                // 응답 헤더 확인
                sh "curl -I https://www.tickle-ticket.co.kr/"
            }
        }
    }

    post {
        success {
            script {
                def shortCommit = env.GIT_COMMIT?.take(7) ?: 'N/A'
                def msg = """{"text": "✅ **tickle 프론트엔드 배포 성공!**\\n- 커밋: ${shortCommit}\\n- 메인: https://www.tickle-ticket.co.kr\\n- 스토리북: https://www.tickle-ticket.co.kr/storybook"}"""
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '${msg}' ${env.MATTERMOST_WEBHOOK}"
            }
        }
        failure {
            script {
                def msg = """{"text": "🚨 **tickle 프론트 배포 실패!**\\n로그 확인: ${env.BUILD_URL}"}"""
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '${msg}' ${env.MATTERMOST_WEBHOOK}"
            }
        }
    }
}