pipeline {
    agent any

    tools {
        nodejs 'node20' 
    }

    environment {
        PROJECT_PATH = "view/fe/tickle"
        EC2_USER = "ubuntu"
        EC2_IP = "3.38.111.218"
        TARGET_DIR = "/home/ubuntu/S14P31A203/view/fe/tickle"
        SSH_CREDENTIAL_ID = "fe-ec2-key"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "===== [1/4] 소스 코드 체크아웃 ====="
                checkout scm
            }
        }

        stage('FE Build') {
            steps {
                dir("${env.PROJECT_PATH}") {
                    echo "===== [2/4] pnpm 환경 구축 및 빌드 ====="
                    sh "npm install -g pnpm"
                    
                    // --shamefully-hoist: react-datepicker 등의 타입 인식 문제 해결
                    sh """
                        rm -rf node_modules
                        pnpm install --no-frozen-lockfile --shamefully-hoist
                        pnpm approve-builds
                        NEXT_PUBLIC_API_MOCKING=disabled pnpm build
                    """
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${env.PROJECT_PATH}") {
                    echo "===== [3/4] SSH 키 권한 설정 및 파일 전송 ====="
                    sh "tar -czf deploy.tar.gz .next public package.json pnpm-lock.yaml next.config.ts"

                    sshagent([SSH_CREDENTIAL_ID]) {
                        script {
                            // 사용자님 말씀대로 실제 임시 키가 생성된 위치를 정확히 타격합니다.
                            // dir() 내부이므로 현재 폴더 바로 옆의 @tmp를 가리킵니다.
                            def tempKeyPath = "${env.WORKSPACE}/${env.PROJECT_PATH}@tmp"
                            sh """
                                chmod 700 ${tempKeyPath}
                                chmod 400 ${tempKeyPath}/private_key*
                            """
                            echo "✅ 임시 키 권한을 400으로 조율했습니다."
                        }

                        // 1. EC2 서버 폴더 준비 및 소유권 설정
                        sh """
                            ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ${EC2_USER}@${EC2_IP} \
                            "mkdir -p ${TARGET_DIR} && sudo chown -R ${EC2_USER}:${EC2_USER} /home/ubuntu/S14P31A203"
                        """

                        // 2. 빌드 파일 전송
                        sh "scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null deploy.tar.gz ${EC2_USER}@${EC2_IP}:${TARGET_DIR}"

                        // 3. 도커 컴포즈 배포 실행
                        sh """
                            ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ${EC2_USER}@${EC2_IP} "
                                cd ${TARGET_DIR} &&
                                tar -xzf deploy.tar.gz &&
                                rm deploy.tar.gz &&
                                docker compose up -d --build
                            "
                        """
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                echo "===== [4/4] 컨테이너 상태 확인 ====="
                sshagent([SSH_CREDENTIAL_ID]) {
                    sh "ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} 'docker compose ps'"
                }
            }
        }
    }

    post {
        success {
            script {
                def message = "✅ **Tickle 프론트 배포 성공!**\n- 빌드 번호: #${env.BUILD_NUMBER}"
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '{\"text\": \"${message}\"}' https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr"
            }
        }
        failure {
            script {
                def message = "🚨 **Tickle 프론트 배포 실패!**\n- 로그 확인: ${env.BUILD_URL}"
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '{\"text\": \"${message}\"}' https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr"
            }
        }
    }
}