pipeline {
    agent any

    tools {
        // 젠킨스 도구 설정에 등록된 Node.js 20 사용
        nodejs 'node20' 
    }

    environment {
        // 프로젝트 경로 및 서버 정보
        PROJECT_PATH = "view/fe/tickle"
        EC2_USER = "ubuntu"
        EC2_IP = "3.38.111.218"
        TARGET_DIR = "/home/ubuntu/S14P31A203/view/fe/tickle"
        
        // 젠킨스 Credentials ID (Jenkins 관리 > Credentials에서 등록한 ID)
        SSH_CREDENTIAL_ID = "fe-ec2-key"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "===== [1/4] 소스 코드 체크아웃 ====="
                checkout scm
            }
        }

        stage('FE Build') {
            steps {
                dir("${env.PROJECT_PATH}") {
                    echo "===== [2/4] pnpm 빌드 (타입 체크 포함) ====="
                    sh "npm install -g pnpm"
                    
                    // --shamefully-hoist: react-datepicker 등 의존성 라이브러리의 타입 에러 해결
                    sh """
                        rm -rf node_modules
                        pnpm install --no-frozen-lockfile --shamefully-hoist
                        pnpm approve-builds
                    """
                    
                    sh "NEXT_PUBLIC_API_MOCKING=disabled pnpm build"
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${env.PROJECT_PATH}") {
                    echo "===== [3/4] SSH 권한 설정 및 파일 전송 ====="
                    
                    // 배포 대상 파일 압축 (next.config.ts 확장자 확인 필요)
                    sh "tar -czf deploy.tar.gz .next public package.json pnpm-lock.yaml next.config.ts"

                    sshagent([SSH_CREDENTIAL_ID]) {
                        // [핵심] SSH 에이전트가 생성한 임시 키 파일에 chmod 400 부여
                        // WORKSPACE 변수를 사용하여 절대 경로로 접근함으로써 'No such file' 에러를 방지합니다.
                        script {
                            try {
                                sh "chmod 700 ${env.WORKSPACE}@tmp"
                                sh "chmod 400 ${env.WORKSPACE}@tmp/private_key*"
                                echo "✅ 임시 키 권한 설정 완료 (400)"
                            } catch (Exception e) {
                                echo "⚠️ 권한 설정 단계 건너뜀 (이미 에이전트가 키를 로드했을 수 있습니다)"
                            }
                        }

                        // 1. EC2 서버 측 목적지 폴더 생성 및 소유권 강제 변경
                        sh """
                            ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ${EC2_USER}@${EC2_IP} \
                            "mkdir -p ${TARGET_DIR} && sudo chown -R ${EC2_USER}:${EC2_USER} /home/ubuntu/S14P31A203"
                        """

                        // 2. 압축 파일 전송
                        sh "scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null deploy.tar.gz ${EC2_USER}@${EC2_IP}:${TARGET_DIR}"

                        // 3. 서버 내부에서 압축 해제 및 도커 컴포즈 재시작
                        sh """
                            ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ${EC2_USER}@${EC2_IP} "
                                cd ${TARGET_DIR} &&
                                tar -xzf deploy.tar.gz &&
                                rm deploy.tar.gz &&
                                docker compose up -d --build
                            "
                        """
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                echo "===== [4/4] 배포 결과 확인 ====="
                sshagent([SSH_CREDENTIAL_ID]) {
                    sh "ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} 'docker compose ps'"
                }
            }
        }
    }

    post {
        success {
            script {
                def message = "✅ **Withy 프론트 배포 성공!**\n- 빌드 번호: #${env.BUILD_NUMBER}\n- 주소: http://${env.EC2_IP}:3000"
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '{\"text\": \"${message}\"}' https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr"
            }
        }
        failure {
            script {
                def message = "🚨 **Withy 프론트 배포 실패!**\n- 로그 확인: ${env.BUILD_URL}"
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '{\"text\": \"${message}\"}' https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr"
            }
        }
    }
}