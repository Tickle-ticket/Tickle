pipeline {
    agent any

    tools {
        nodejs 'node20' 
    }

    environment {
        PROJECT_PATH = "view/fe/tickle"
        EC2_USER = "ubuntu"
        EC2_IP = "3.38.111.218"
        TARGET_DIR = "/home/ubuntu/S14P31A203/view/fe/tickle"
        SSH_CREDENTIAL_ID = "fe-ec2-key"
    }

    stages {
        stage('Checkout') {
            steps {
                echo "===== [1/4] 소스 코드 체크아웃 ====="
                checkout scm
            }
        }

        stage('FE Build') {
            steps {
                dir("${env.PROJECT_PATH}") {
                    echo "===== [2/4] pnpm 환경 구축 및 Next.js 빌드 ====="
                    sh "npm install -g pnpm"
                    
                    // 핵심 해결책: 호이스팅 강제로 타입 에러 해결 및 보안 정책 승인
                    sh """
                        rm -rf node_modules
                        pnpm install --no-frozen-lockfile --shamefully-hoist
                        pnpm approve-builds
                    """
                    
                    // Next.js 빌드 (Turbopack 사용 중임을 로그에서 확인)
                    sh "NEXT_PUBLIC_API_MOCKING=disabled pnpm build"
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${env.PROJECT_PATH}") {
                    echo "===== [3/4] 빌드 파일 전송 및 도커 배포 ====="
                    
                    // 빌드 파일 압축 (next.config.ts 확장자 포함)
                    sh "tar -czf deploy.tar.gz .next public package.json pnpm-lock.yaml next.config.ts"

                    sshagent([SSH_CREDENTIAL_ID]) {
                        // 1. 서버 폴더 생성 및 권한 설정
                        sh "ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} 'mkdir -p ${TARGET_DIR} && sudo chown -R ${EC2_USER}:${EC2_USER} ${TARGET_DIR}'"

                        // 2. 압축 파일 전송
                        sh "scp -o StrictHostKeyChecking=no deploy.tar.gz ${EC2_USER}@${EC2_IP}:${TARGET_DIR}"

                        // 3. 서버 내부에서 압축 해제 및 도커 컴포즈 재시작
                        sh """
                            ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} "
                                cd ${TARGET_DIR} &&
                                tar -xzf deploy.tar.gz &&
                                rm deploy.tar.gz &&
                                docker compose up -d --build
                            "
                        """
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                echo "===== [4/4] 컨테이너 가동 상태 확인 ====="
                sshagent([SSH_CREDENTIAL_ID]) {
                    sh "ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_IP} 'docker compose ps'"
                }
            }
        }
    }

    post {
        success {
            script {
                def message = "✅ **Withy 프론트 배포 성공!**\n- 빌드 번호: #${env.BUILD_NUMBER}\n- 접속 주소: http://${env.EC2_IP}:3000"
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '{\"text\": \"${message}\"}' https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr"
            }
        }
        failure {
            script {
                def message = "🚨 **Withy 프론트 배포 실패!**\n- 로그 확인: ${env.BUILD_URL}"
                sh "curl -s -X POST -H 'Content-Type: application/json' -d '{\"text\": \"${message}\"}' https://meeting.ssafy.com/hooks/riktjr5mz78g5xfot3p4pz4nnr"
            }
        }
    }
}