# Tickle 환경 변수 예시 파일
# 실제 비밀번호, API Key, Secret 값은 이 파일에 입력해서 커밋하지 않는다.
# 운영 배포 시에는 프로젝트 루트의 .env에 실제 값을 작성한다.
# 로컬 실행 시에는 각 서비스 디렉터리의 .env에 필요한 값만 작성한다.

###############################################################################
# 공통 / Infra
###############################################################################

# Server 1 사설 IP: MySQL, Redis Master, Core BE가 배포되는 서버
SERVER1_PRIVATE_IP=

# Server 2 사설 IP: Kafka, Zookeeper가 배포되는 서버
SERVER2_PRIVATE_IP=

# Server 3 사설 IP: 모니터링/트레이싱 인프라가 배포되는 서버
SERVER3_PRIVATE_IP=

# Server 4 사설 IP: Auth 서버가 배포되는 서버
SERVER4_PRIVATE_IP=

# MySQL root 비밀번호
MYSQL_ROOT_PASSWORD=

# MySQL 일반 계정 비밀번호가 필요한 경우 사용
MYSQL_PASSWORD=

# Grafana admin 비밀번호
GRAFANA_PASSWORD=

# BE/Auth 내부 API 호출 검증용 공유 시크릿
INTERNAL_SECRET=

# JWT HS256 서명 키. Core BE와 Auth가 반드시 같은 값을 사용한다.
JWT_SECRET=

###############################################################################
# Core BE / Auth 공통 Spring, DB, Redis 설정
###############################################################################

# Spring profile. 운영/로컬 compose 기준 local 사용
SPRING_PROFILES_ACTIVE=local

# MySQL 호스트. Core BE 로컬은 localhost 또는 tickle-mysql, Auth 운영은 Server 1 사설 IP 사용
DB_HOST=

# MySQL 포트
DB_PORT=3306

# DB 이름. Core BE는 tickle_core, Auth는 tickle_auth 사용
DB_NAME=

# DB 사용자명
DB_USERNAME=root

# DB 비밀번호
DB_PASSWORD=

# Hibernate DDL 전략. 운영은 update, 로컬 초기화는 create 또는 update 사용
JPA_DDL_AUTO=update

# SQL 로그 출력 여부. 운영은 false 권장
JPA_SHOW_SQL=false

# Redis 비밀번호. 미설정 Redis는 빈 문자열 사용
REDIS_PASSWORD=

# 애플리케이션 HTTP 포트. Core BE는 8080, Auth는 8081 사용
SERVER_PORT=

###############################################################################
# Core BE 전용
###############################################################################

# Java 21 Virtual Thread 활성화 여부
VIRTUAL_THREADS_ENABLED=true

# Docker 컨테이너 JVM 옵션
JAVA_TOOL_OPTIONS=-Xms512m -Xmx1792m

# Kafka broker 주소
KAFKA_BOOTSTRAP_SERVERS=

# Kafka consumer group id
KAFKA_CONSUMER_GROUP_ID=tickle-group

# Core BE가 Auth 내부 API를 호출할 때 사용하는 URL
AUTH_INTERNAL_URL=

# AI 내부 서버 URL
AI_INTERNAL_URL=

# 허용할 프론트엔드 Origin
CORS_FE_ORIGIN=

# 로컬 테스트용 모든 Origin 허용 여부. 운영에서는 false 사용
ALLOW_ALL_ORIGINS=false

# AWS S3 버킷명
AWS_S3_BUCKET=

# AWS Region
AWS_REGION=ap-northeast-2

# AWS Access Key
AWS_ACCESS_KEY=

# AWS Secret Key
AWS_SECRET_KEY=

# 카카오페이 Open API 기본 URL
KAKAOPAY_BASE_URL=https://open-api.kakaopay.com

# 카카오페이 Open API Secret Key
KAKAOPAY_SECRET_KEY=

# 카카오페이 CID. 테스트 기본값은 TC0ONETIME
KAKAOPAY_CID=TC0ONETIME

# 카카오페이 결제 승인 callback URL
KAKAOPAY_APPROVAL_URL=

# 카카오페이 결제 실패 callback URL
KAKAOPAY_FAIL_URL=

# 카카오페이 결제 취소 callback URL
KAKAOPAY_CANCEL_URL=

# 카카오페이 승인 후 프론트엔드 redirect URL
KAKAOPAY_SUCCESS_REDIRECT_URL=

# 카카오페이 실패 후 프론트엔드 redirect URL
KAKAOPAY_FAILED_REDIRECT_URL=

# 카카오페이 취소 후 프론트엔드 redirect URL
KAKAOPAY_CANCELLED_REDIRECT_URL=

# Cloudflare Turnstile 검증 Secret Key
CLOUDFLARE_TURNSTILE_SECRET_KEY=

###############################################################################
# Auth 전용
###############################################################################

# Access Token 만료 시간(초)
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=7200

# Refresh Token 만료 시간(초)
JWT_REFRESH_TOKEN_EXPIRY_SECONDS=604800

# Auth가 Core BE 내부 API를 호출할 때 사용하는 URL
BE_INTERNAL_URL=

# 관리자 가입/인증용 시크릿. 운영에서는 별도 값으로 교체
ADMIN_SECRET=

# Kakao Developers REST API Key
KAKAO_REST_API_KEY=

# Kakao Developers Client Secret. 사용하지 않으면 빈 문자열 가능
KAKAO_CLIENT_SECRET=

# Kakao OAuth redirect URI
KAKAO_REDIRECT_URI=

# Kakao OAuth scope
KAKAO_SCOPE=account_email,profile_nickname,profile_image

# Kakao 인증 서버 URL
KAKAO_AUTH_BASE_URL=https://kauth.kakao.com

# Kakao API 서버 URL
KAKAO_API_BASE_URL=https://kapi.kakao.com

###############################################################################
# CoolSMS
###############################################################################

# CoolSMS API Key
COOLSMS_API_KEY=

# CoolSMS API Secret
COOLSMS_API_SECRET=

# CoolSMS 승인 발신번호
COOLSMS_SENDER_NUMBER=

###############################################################################
# AI / Behavior Ingest / Kafka / PostgreSQL
###############################################################################
# 아래 변수명은 services/ai/docker/docker-compose.yml에서 그대로 사용하는 이름이다.
# Core BE/Auth와 같은 root .env에 합쳐 쓰지 말고, AI 배포 시에는
# services/ai/docker/.env에 별도로 작성하는 것을 권장한다.

# Kafka broker를 EC2 host에서 접근할 때 사용할 포트
KAFKA_PORT=19092

# Kafka UI 웹 화면 접근 포트. AI docker compose debug profile에서만 사용
KAFKA_UI_PORT=18088

# 브라우저 행동 데이터가 적재되는 AI 메인 Kafka topic
KAFKA_TOPIC_BEHAVIOR_EVENTS=behavior-events-v1

# 행동 데이터 topic partition 수
KAFKA_TOPIC_BEHAVIOR_EVENTS_PARTITIONS=3

# 처리 실패 메시지를 저장할 Dead Letter Queue topic
KAFKA_TOPIC_DLQ=behavior-events-dlq-v1

# DLQ topic partition 수
KAFKA_TOPIC_DLQ_PARTITIONS=1

# Kafka topic 기본 partition 수
KAFKA_DEFAULT_PARTITIONS=3

# Kafka 메시지 보관 시간. 168시간은 7일
KAFKA_LOG_RETENTION_HOURS=168

# Kafka 로그 전체 보관 크기 제한. 1GB
KAFKA_LOG_RETENTION_BYTES=1073741824

# Kafka 로그 segment 파일 크기. 256MB
KAFKA_LOG_SEGMENT_BYTES=268435456

# Kafka 단일 메시지 최대 크기. 1MB
KAFKA_MESSAGE_MAX_BYTES=1048576

# AI PostgreSQL을 EC2 host에서 접근할 때 사용할 포트
POSTGRES_PORT=15432

# AI PostgreSQL database 이름
POSTGRES_DB=

# AI PostgreSQL 사용자 이름
POSTGRES_USER=

# AI PostgreSQL 비밀번호
POSTGRES_PASSWORD=

# Backend 서버가 AI 내부 API를 호출할 때 사용할 host port
AI_API_PORT=

# AI Worker Kafka consumer group id
KAFKA_CONSUMER_GROUP_ID=ai-worker-group-v1

# type별 ensemble 모델 사용 여부
USE_TYPE_ENSEMBLE=true

# AI 모델 artifact root
MODELS_ROOT=/app/models

# ensemble classifier 디렉터리 목록
ENSEMBLE_CLASSIFIER_DIRS=classifier,classifier_1,classifier_2

# ensemble voting 방식. soft 또는 hard
ENSEMBLE_VOTING=soft

# type별 threshold JSON 경로
THRESHOLDS_PATH=/app/models/thresholds.json

# 단일 모델 fallback 경로. AI_USE_TYPE_ENSEMBLE=false일 때 사용
MODEL_PATH=/app/models/classifier/model.joblib

# 단일 모델 fallback input feature 목록 경로
INPUT_FEATURES_PATH=/app/models/classifier/input_features.json

# ALLOW 판정 최대 점수
ALLOW_MAX_SCORE=0.40

# BLOCK 판정 최소 점수
BLOCK_MIN_SCORE=0.75

# AI Worker micro-batch 크기
AI_WORKER_BATCH_SIZE=16

# AI Worker partial batch flush 최대 대기 시간
AI_WORKER_FLUSH_INTERVAL_SEC=0.2

# Spring Boot Behavior Ingest server profile
SPRING_PROFILES_ACTIVE=prod

# Behavior Ingest host port
INGEST_PORT=18080

# Behavior Ingest 호출을 허용할 browser origin 목록
INGEST_CORS_ALLOWED_ORIGINS=

# BE bot detection result callback URL. 비워두면 AI Worker callback 생략
BE_BOT_DETECTION_RESULT_URL=

# BE callback timeout seconds
BE_CALLBACK_TIMEOUT_SEC=2.0

# BE callback용 내부 service token
BE_INTERNAL_SERVICE_TOKEN=

# BE callback용 내부 secret. BE INTERNAL_SECRET과 같은 값 사용
BE_INTERNAL_SECRET=

# BE callback 테스트/기본 사용자 ID
BE_CALLBACK_USER_ID=1001
