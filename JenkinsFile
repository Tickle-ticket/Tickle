// Jenkinsfile
// 목적: develop-be 브랜치에 코드가 머지되면
//       자동으로 빌드 → 이미지 push → 서버 배포까지 진행한다.

pipeline {
    agent any

    // ── 전역 환경변수 ──────────────────────────────────────────
    environment {
        // GitLab Container Registry 주소
        REGISTRY     = 'registry.lab.ssafy.com/s14-final/s14p31a203'
        // 배포 대상 서버 사설 IP
        SERVER1_IP   = '172.31.63.75'   // 메인 BE 서버
        SERVER4_IP   = '172.31.62.10'   // 인증 서버
        // 변경된 서비스 감지 플래그
        BUILD_BE     = 'false'
        BUILD_AUTH   = 'false'
    }

    stages {

        // ── 1단계: 코드 체크아웃 ───────────────────────────────
        stage('Checkout') {
            steps {
                echo '===== [1/5] 코드 체크아웃 시작 ====='
                checkout scm
                echo "브랜치: ${env.GIT_BRANCH}"
                echo "커밋: ${env.GIT_COMMIT}"
            }
        }

        // ── 2단계: 변경된 서비스 감지 ─────────────────────────
        stage('Detect Changes') {
            steps {
                echo '===== [2/5] 변경된 서비스 감지 시작 ====='
                script {
                    def changes = sh(
                        script: "git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only HEAD",
                        returnStdout: true
                    ).trim()

                    echo "변경된 파일 목록:\n${changes}"

                    env.BUILD_BE   = changes.contains('services/be/')   ? 'true' : 'false'
                    env.BUILD_AUTH = changes.contains('services/auth/') ? 'true' : 'false'

                    echo "BE 배포 필요: ${env.BUILD_BE}"
                    echo "Auth 배포 필요: ${env.BUILD_AUTH}"
                }
            }
        }

        // ── 3단계: BE 빌드 및 이미지 push ─────────────────────
        // services/be/ 하위 파일이 변경된 경우에만 실행된다.
        // 서버 1(amd64)에서 네이티브 빌드한다.
        // Jenkins 서버(arm64)에서 amd64 이미지를 빌드하면
        // QEMU 에뮬레이션으로 10~20배 느려지기 때문이다.
        stage('Build & Push BE') {
            when {
                environment name: 'BUILD_BE', value: 'true'
            }
            steps {
                echo '===== [3/5] BE 빌드 및 이미지 push 시작 ====='
                sshagent(['tickle-deploy-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@${SERVER1_IP} '
                            echo "[BE] 코드 최신화 시작"
                            cd ~/S14P31A203
                            git fetch origin
                            git checkout develop-be
                            git pull origin develop-be

                            echo "[BE] Docker 이미지 빌드 시작"
                            docker build -t ${REGISTRY}/be:latest ./services/be
                            docker build -t ${REGISTRY}/be:${env.GIT_COMMIT[0..6]} ./services/be

                            echo "[BE] GitLab Registry push 시작"
                            docker push ${REGISTRY}/be:latest
                            docker push ${REGISTRY}/be:${env.GIT_COMMIT[0..6]}

                            echo "[BE] 빌드 및 push 완료"
                        '
                    """
                }
                echo 'BE 이미지 push 완료!'
            }
        }

        // ── 4단계: BE 배포 ─────────────────────────────────────
        // 서버 1에서 새 이미지로 컨테이너를 재시작한다.
        // down 후 up을 하지 않고 pull 후 up -d를 사용해서
        // MySQL, Redis 컨테이너가 중단되지 않도록 한다.
        stage('Deploy BE') {
            when {
                environment name: 'BUILD_BE', value: 'true'
            }
            steps {
                echo '===== [4/5] BE 배포 시작 ====='
                sshagent(['tickle-deploy-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@${SERVER1_IP} '
                            echo "[BE] 새 이미지로 컨테이너 재시작"
                            cd ~/S14P31A203
                            docker compose --env-file .env -f infra/docker-compose/server1-main.yml pull be
                            docker compose --env-file .env -f infra/docker-compose/server1-main.yml up -d be
                            echo "[BE] 배포 완료"
                        '
                    """
                }
                echo 'BE 배포 완료!'
            }
        }

        // ── 5단계: Auth 빌드 및 배포 ──────────────────────────
        // services/auth/ 하위 파일이 변경된 경우에만 실행된다.
        stage('Build & Deploy Auth') {
            when {
                environment name: 'BUILD_AUTH', value: 'true'
            }
            steps {
                echo '===== [5/5] Auth 빌드 및 배포 시작 ====='
                sshagent(['tickle-deploy-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@${SERVER4_IP} '
                            echo "[Auth] 코드 최신화 시작"
                            cd ~/S14P31A203
                            git fetch origin
                            git checkout develop-be
                            git pull origin develop-be

                            echo "[Auth] Docker 이미지 빌드 시작"
                            docker build -t ${REGISTRY}/auth:latest ./services/auth
                            docker push ${REGISTRY}/auth:latest

                            echo "[Auth] 컨테이너 재시작"
                            docker compose --env-file .env -f infra/docker-compose/server4-auth.yml pull auth
                            docker compose --env-file .env -f infra/docker-compose/server4-auth.yml up -d auth
                            echo "[Auth] 배포 완료"
                        '
                    """
                }
                echo 'Auth 배포 완료!'
            }
        }

    }

    // ── 빌드 후 처리 ──────────────────────────────────────────
    post {
        success {
            echo """
            ========================================
            ✅ CD 배포 성공!
            브랜치: ${env.GIT_BRANCH}
            커밋: ${env.GIT_COMMIT}
            ========================================
            """
        }
        failure {
            echo """
            ========================================
            ❌ CD 배포 실패!
            브랜치: ${env.GIT_BRANCH}
            커밋: ${env.GIT_COMMIT}
            빌드 로그를 확인해서 문제를 수정해주세요.
            ========================================
            """
        }
        always {
            echo '===== CD 파이프라인 종료 ====='
        }
    }
}