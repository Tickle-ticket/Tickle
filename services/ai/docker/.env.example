# -------------------------  Kafka & PostgreSQL

# Kafka broker를 EC2 호스트에서 접근할 때 사용할 포트
KAFKA_PORT=19092

# Kafka UI 웹 화면 접근 포트, debug profile에서만 사용
KAFKA_UI_PORT=18088

# 브라우저 행동 데이터가 적재되는 메인 Kafka topic
KAFKA_TOPIC_BEHAVIOR_EVENTS=behavior-events-v1

# 행동 데이터 topic의 partition 수, AI Worker 병렬 처리 확장 단위
KAFKA_TOPIC_BEHAVIOR_EVENTS_PARTITIONS=3

# 처리 실패 메시지를 저장할 Dead Letter Queue topic
KAFKA_TOPIC_DLQ=behavior-events-dlq-v1

# DLQ topic partition 수, 초기에는 실패 메시지 보관용이라 1개로 시작
KAFKA_TOPIC_DLQ_PARTITIONS=1

# Kafka topic 기본 partition 수, 명시 생성 topic 외 기본값
KAFKA_DEFAULT_PARTITIONS=3

# Kafka 메시지 보관 시간, 168시간은 7일
KAFKA_LOG_RETENTION_HOURS=168

# Kafka 로그 전체 보관 크기 제한, 1GB
KAFKA_LOG_RETENTION_BYTES=1073741824

# Kafka 로그 segment 파일 크기, 256MB
KAFKA_LOG_SEGMENT_BYTES=268435456

# Kafka 단일 메시지 최대 크기, 1MB
KAFKA_MESSAGE_MAX_BYTES=1048576

# PostgreSQL을 EC2 호스트에서 접근할 때 사용할 포트
POSTGRES_PORT=15432

# PostgreSQL database 이름
POSTGRES_DB=change

# PostgreSQL 사용자 이름
POSTGRES_USER=change

# PostgreSQL 비밀번호 예시값, 실제 .env에서는 반드시 변경
POSTGRES_PASSWORD=change

# -------------------------  ai worker

# Backend 서버가 AI 내부 API를 호출할 때 사용할 host port
AI_API_PORT=

# AI Worker Kafka consumer group id
KAFKA_CONSUMER_GROUP_ID=ai-worker-group-v1

# Inference model type, joblib or onnx
MODEL_TYPE=joblib

# Model file path inside ai-worker container
MODEL_PATH= /app/models/classifier/OO.joblib

# Feature order file path inside ai-worker container
INPUT_FEATURES_PATH= /app/...

# Thresholds for allow, review, block
ALLOW_MAX_SCORE=0.00
BLOCK_MIN_SCORE=0.00

# AI Worker micro-batch size
AI_WORKER_BATCH_SIZE=16

# AI Worker max wait time before flushing partial batch
AI_WORKER_FLUSH_INTERVAL_SEC=0.2

# -------------------------  Spring Boot (Ingest)

# Spring Boot Behavior Ingest server profile
SPRING_PROFILES_ACTIVE=prod

# Behavior Ingest host port
INGEST_PORT=18080

# Comma-separated browser origins allowed to call ingest.
INGEST_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://k14a203.p.ssafy.io:3000

# ------------------------- AWS (BE)

# AWS(BE) bot detection result callback URL, leave blank to skip callback
BE_BOT_DETECTION_RESULT_URL=

# AWS(BE) callback timeout seconds
BE_CALLBACK_TIMEOUT_SEC=2.0

# Internal service token for AWS(BE) callback
BE_INTERNAL_SERVICE_TOKEN=
BE_INTERNAL_SECRET=
BE_CALLBACK_USER_ID=1001
