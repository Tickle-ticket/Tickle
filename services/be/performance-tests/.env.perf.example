# =============================================================
# Tickle 성능 테스트 환경 변수 예시
# 사용: cp .env.perf.example .env.perf 후 값 채워서 사용
# =============================================================

# 대상 서버 (BE / Auth)
BASE_URL=https://tickle-ticket.co.kr
AUTH_BASE_URL=https://tickle-ticket.co.kr

# 테스트 계정 (사전에 회원가입 + 휴대폰 인증 완료된 계정이어야 함)
TEST_USER_EMAIL=perf-test@example.com
TEST_USER_PASSWORD=testPassword1!

# 테스트 대상 데이터 (실제 ID로 교체)
# - TEST_EVENT_ID: EventOpenInfo 캐시가 적재된 공연 ID
# - TEST_SCHEDULE_ID: 해당 공연의 회차 ID
# - TEST_SEAT_IDS: 콤마 구분된 sessionSeat ID 목록 (최대 4개씩 사용)
TEST_EVENT_ID=1
TEST_SCHEDULE_ID=1
TEST_SEAT_IDS=101,102,103,104,105

# Prometheus Remote Write (server3 IP)
PROMETHEUS_REMOTE_WRITE_URL=http://<SERVER3_PRIVATE_IP>:9090/api/v1/write

# admitToken이 필요한 좌석 hold 시나리오를 강제로 스킵할지 여부 (true/false)
# admit 발급 절차가 어려운 환경에서 임시로 false로 두면 hold 시나리오는 401만 검증한다.
SEAT_HOLD_REQUIRE_ADMIT=true
