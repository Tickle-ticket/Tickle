# 로컬 BE 주소
BASE_URL=http://localhost:8080
AUTH_BASE_URL=http://localhost:8080

# 로컬 테스트용 pre-generated JWT 사용 (auth 서비스 없이 동작)
# 이 값이 설정되면 auth.js의 login()을 건너뜀
PRE_GENERATED_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxNTAwMDAxIiwicm9sZSI6IkFETUlOIiwiaWF0IjoxNzc5MTUyOTQ4LCJleHAiOjE3ODE3NDQ5NDh9.JfM6vTph56Akr2Z_d8x3pwHNGY08fwMytVaLaTG6S4w

# 테스트 대상 데이터 (로컬 DB에 삽입된 event 6058)
TEST_EVENT_ID=6058
TEST_SCHEDULE_ID=6058
TEST_SEAT_IDS=6001,6002,6003,6004,6005

# Prometheus (미설정 → 로컬 summary만)
PROMETHEUS_REMOTE_WRITE_URL=

# 좌석 선점 설정 (OPENED 세션 있으므로 admit 우선 false)
SEAT_HOLD_REQUIRE_ADMIT=false
PRE_ADMIT_TOKEN=

# (더미 - login() 호출 시 사용)
